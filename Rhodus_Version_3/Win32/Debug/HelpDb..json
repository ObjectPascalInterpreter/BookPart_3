{"listOfHelpEntries":[{"recordType":"rtModule","moduleName":"math","description":"This is the math module","methods":[{"methodType":"hmtMethod","methodName":"sin","signature":"sin (int|float|array)","description":"Returns the sine of the argument measured in radians.","examples":["x = math.sin (1.2)","x = math.sin (math.pi)","x = math.sin ([1,2,3])"]},{"methodType":"hmtMethod","methodName":"cos","signature":"cos (int|float|array))","description":"Returns the cosine of the argument measured in radians.","examples":["x = math.cos (1.2)","x = math.cos (math.pi)","x = math.cos ([1,2,3])"]},{"methodType":"hmtMethod","methodName":"tan","signature":"tan (int|float|array))","description":"Returns the tangent of the argument measured in radians.","examples":["x = math.tan (1.2)","x = math.tan (math.pi)","x = math.tan ([1,2,3])"]},{"methodType":"hmtMethod","methodName":"asin","signature":"asin (int|float|array))","description":"It works out the asin","examples":["x = math.asin (1.2)","x = math.asin (math.pi)","x = math.asin ([1,2,3])"]},{"methodType":"hmtMethod","methodName":"acos","signature":"acos (int|float|array))","description":"It works out the acos","examples":["x = math.acos (1.2)","x = math.acos (math.pi)","x = math.acos ([1,2,3])"]},{"methodType":"hmtMethod","methodName":"atan","signature":"atan (int|float|array))","description":"It works out the atan","examples":["x = math.atan (1.2)","x = math.atan (math.pi)","x = math.atan ([1,2,3])"]},{"methodType":"hmtMethod","methodName":"toDegrees","signature":"toDegrees (int|float))","description":"Use this method to convert radians to degrees.","examples":["x = math.toDegrees (math.pi)","x = math.toDegrees (6.5)"]},{"methodType":"hmtMethod","methodName":"toRadians","signature":"toRadians(int|float))","description":"Use this method to convert degrees to radians.","examples":["x = math.toRadians (90)","x = math.toRadians (45)","x = math.sin (math.toRadians (45))"]},{"methodType":"hmtMethod","methodName":"sqr","signature":"sqr(int|float))","description":"Computes the square of a number.","examples":["x = math.sqr (9)"]},{"methodType":"hmtMethod","methodName":"sqrt","signature":"sqrt(int|float))","description":"Computes the square root of a number. Negative values are not supported.","examples":["x = math.sqrt (9)"]},{"methodType":"hmtMethod","methodName":"exp","signature":"exp(int|float))","description":"Computes e raised to the power of a value","examples":["x = math.exp (9)"]},{"methodType":"hmtMethod","methodName":"ln","signature":"ln(int|float))","description":"Computes the natural logarithm of a value.","examples":["x = math.ln (9)"]},{"methodType":"hmtMethod","methodName":"log","signature":"log(int|float))","description":"Computes the logarithm to base 10 of a value","examples":["x = math.llog (1000)"]},{"methodType":"hmtMethod","methodName":"abs","signature":"abs(int|float))","description":"Returns the absolute value of a number.","examples":["x = math.abs (9)"]},{"methodType":"hmtMethod","methodName":"round","signature":"round(int|float))","description":"Returns a value to the nearest whole number.","examples":["x = math.abs (2.3)"]},{"methodType":"hmtMethod","methodName":"ceil","signature":"ceil(int|float))","description":"Rounds variables up toward positive infinity.","examples":["x = math.ceil (4.3)"]},{"methodType":"hmtMethod","methodName":"floor","signature":"floor(int|float))","description":"Returns the largest integer less than or equal to a given number.","examples":["x = math.floor (4.3)"]},{"methodType":"hmtMethod","methodName":"trunc","signature":"trunc(int|float))","description":"Returns the integer part of floating point number.","examples":["x = math.trunc (4.3)"]},{"methodType":"hmtMethod","methodName":"max","signature":"max(int|float))","description":"Returns the maximum of two numbers","examples":["x = math.max (2,4)"]},{"methodType":"hmtMethod","methodName":"min","signature":"min(int|float))","description":"Returns the minimum of two numbers.","examples":["x = math.min (4, 3)"]},{"methodType":"hmtValue","methodName":"pi","signature":"","description":"Returns the value of pi","examples":["x = math.pi"]},{"methodType":"hmtValue","methodName":"eps","signature":"","description":"Values below this are considered zero.","examples":["x = math.eps"]}]},{"recordType":"rtModule","moduleName":"random","description":"This is the random module","methods":[{"methodType":"hmtMethod","methodName":"seed","signature":"seed()","description":"Set the seed for the random number generator","examples":["seed (23)"]},{"methodType":"hmtMethod","methodName":"random","signature":"randm()","description":"Return a uniformly distributed random number","examples":["random()"]}]},{"recordType":"rtModule","moduleName":"strings","description":"This is the string module","methods":[{"methodType":"hmtMethod","methodName":"str","signature":"str(string)","description":"Converts a string into a number","examples":["value = strings.str (\"1.23\")"]},{"methodType":"hmtMethod","methodName":"val","signature":"val(int|double)","description":"Converts a number into a string","examples":["astr = strings.val(23)"]},{"methodType":"hmtMethod","methodName":"format","signature":"format(int|double, string)","description":"Formats a number and returns a string","examples":["astr = strings.format (2.3456, \"%3.2f\")"]},{"methodType":"hmtMethod","methodName":"random","signature":"random(int)","description":"Generate a rnadom sequenc yyo letter and digits of a given length","examples":["astr = strings.random(15)"]},{"methodType":"hmtValue","methodName":"asciiLower","signature":"","description":"Returns the lower ascii characters as a string","examples":["x = strings.asciiLower"]},{"methodType":"hmtValue","methodName":"asciiUpper","signature":"","description":"Returns the upper ascii characters as a string","examples":["x = strings.asciiUpper"]},{"methodType":"hmtValue","methodName":"digits","signature":"","description":"Returns the digit characters as a string","examples":["x = strings.digits"]}]},{"recordType":"rtModule","moduleName":"sys","description":"This is the sys module","methods":[{"methodType":"hmtValue","methodName":"version","signature":"","description":"Returns the current verison of the interpreter","examples":["x = sys.version"]},{"methodType":"hmtValue","methodName":"doubleFormat","signature":"","description":"Default output format string for double values","examples":["x = sys.doubleFormat"]},{"methodType":"hmtValue","methodName":"integerFormat","signature":"","description":"Default output format string for integer values","examples":["x = sys.integerFormat"]},{"methodType":"hmtValue","methodName":"argv","signature":"","description":"The list of command line arguments passed","examples":["x = sys.argv"]},{"methodType":"hmtValue","methodName":"path","signature":"","description":"Search path for Rhodus import libraries","examples":["x = sys.path"]}]},{"recordType":"rtModule","moduleName":"mat","description":"2D Matrix support library","methods":[{"methodType":"hmtMethod","methodName":"rnd","signature":"rnd(int,int)","description":"Create an array, n by m of uniformly random numbers: m = mat.rnd (4,4)","examples":["m = mat.rnd (4 ,4)"]},{"methodType":"hmtMethod","methodName":"ident","signature":"ident(int)","description":"Create an identity matrix of given size","examples":[" m = mat.ident (4)"]},{"methodType":"hmtMethod","methodName":"matrix","signature":"matrix(int, int)","description":"Create an matrix of zeros of given size.","examples":["m = mat.matrix (3, 2)","","You can create a literal matrix using the symtax m = {{1,2,3},{5,6,7},{8,7,5}}"]},{"methodType":"hmtMethod","methodName":"rndi","signature":"rndi(int(n), int(m), int(lower), int(upper))","description":"Create a matrix of give size n by m of uniformly distributed random integers between lower and upper.","examples":["m = mat.rndi (3, 2, lower, upper)","This method can take a different number of arguments:","m = mat.rndi (3, 2)  Assume a range 1 to 10","m = mat.rndi (3, 2, 20)   Assume a range 1 to 20"]},{"methodType":"hmtMethod","methodName":"csv","signature":"csv(matrix)","description":"Convert a matrix to a csv string.","examples":["astr = mat.csv (m)"]},{"methodType":"hmtMethod","methodName":"inv","signature":"inv(matrix)","description":"Compute inverse of a matrix.","examples":["m = mat.inv (m)"]},{"methodType":"hmtMethod","methodName":"det","signature":"det(matrix)","description":"Compute the deteminant of a matrix.","examples":["d = mat.det (m)"]},{"methodType":"hmtMethod","methodName":"tr","signature":"tr(matrix)","description":"Compute the transpose of a matrix.","examples":["q = mat.tr (m)"]},{"methodType":"hmtMethod","methodName":"lu","signature":"lu(matrix)","description":"Compute the LU decompositon of a matrix.","examples":["[L, U, P] = mat.lu (m)"]},{"methodType":"hmtMethod","methodName":"qr","signature":"qr(matrix)","description":"Compute the QR decompositon of a matrix.","examples":["[Q, R] = mat.qr (m)"]},{"methodType":"hmtMethod","methodName":"rref","signature":"rref(matrix)","description":"Compute the reduced row echelon of a matrix.","examples":["q = mat.rref (m)"]},{"methodType":"hmtMethod","methodName":"solve","signature":"solve(A, b)","description":"Solve: x = mat.solve (m, b). b must be a column matrix.","examples":["x = mat.solve ({{1,2},{3,4}}, {{5},{7}})"]}]},{"recordType":"rtModule","moduleName":"lists","description":"This is the lists module","methods":[{"methodType":"hmtMethod","methodName":"range","signature":"range(start, finish, stepsize)","description":"Create a list based on the range arguments","examples":["l = lists.range (0, 10, 0.5)"]},{"methodType":"hmtMethod","methodName":"rndu","signature":"rndu(integer)","description":"Create a list of uniformly randomly distributed floats between 0 and 1. ","examples":["l = lists.rndu (10)"]},{"methodType":"hmtMethod","methodName":"rndi","signature":"rndi(lower : integer, upper : integer, number of elements : integer)","description":"Create a list of random uniformly distributed integers.","examples":["l = lists.rndi (lower, upper, number)","l = lists.rndi (0, 10, 5)","l = lists.rndi (5, 10, 20)"]}]},{"recordType":"rtDataObject","moduleName":"MatrixObject","description":"This is the matrix object","methods":[{"methodType":"hmtMethod","methodName":"rows","signature":"m.rows ()","description":"Get the number of rows in the matrix: var.rows()","examples":["n = m.rows()","println (p.rows())"]},{"methodType":"hmtMethod","methodName":"cols","signature":"m.cols ()","description":"Get the number of cols in the matrix: var.cols()","examples":["n = m.cols()","println (p.cols())"]},{"methodType":"hmtMethod","methodName":"shape","signature":"m.shape ()","description":"Get the shape of the matrix, that is rows by columns","examples":["[nrows, ncols] = m.shape()","println (p.shape())"]},{"methodType":"hmtMethod","methodName":"row","signature":"m.row (int)","description":"Extract a column from the matrix","examples":["col = m.col(1)"]},{"methodType":"hmtMethod","methodName":"col","signature":"m.col (int)","description":"Extract a row from the matrix","examples":["row = m.row(2)"]},{"methodType":"hmtMethod","methodName":"toArray","signature":"m.toArray ()","description":"Convert a matrix to an array.","examples":["a = m.toArray(m)"]},{"methodType":"hmtMethod","methodName":"toList","signature":"m.toList ()","description":"Convert a matrix to a list.","examples":["l = m.row()"]}]},{"recordType":"rtDataObject","moduleName":"StringObject","description":"This is the string object","methods":[{"methodType":"hmtMethod","methodName":"len","signature":"astr.len ()","description":"Get the length og a string var.len()","examples":["a = \"abcdefg\"","n = a.len()"]},{"methodType":"hmtMethod","methodName":"find","signature":"astr.find ()","description":"Find a substring in string. Returns -1 if it fails, else returns the position","examples":["astr = \"acbcdefgh\"","index = astr.find (\"cd\")"]},{"methodType":"hmtMethod","methodName":"toUpper","signature":"astr.toUpper ()","description":"Converts all letters in the string to upper case","examples":["astr = \"acbcdefgh\"","astr.toUpper ()"]},{"methodType":"hmtMethod","methodName":"toLower","signature":"astr.toLower ()","description":"Converts all letters in the string to upper case","examples":["astr = \"acbcdefgh\"","astr.toLower ()"]},{"methodType":"hmtMethod","methodName":"left","signature":"astr.left (n)","description":"Returns the left n chars of a string","examples":["a = \"acbcdefgh\"","b = a.left (5)"]},{"methodType":"hmtMethod","methodName":"right","signature":"astr.right (n)","description":"Returns the right n chars of a string","examples":["a = \"acbcdefgh\"","b = a.right (5)"]},{"methodType":"hmtMethod","methodName":"mid","signature":"astr.mid (start, count)","description":"Returns a substring of string from start to count characters","examples":["a = \"acbcdefgh\"","b = a.mid (2, 4)"]},{"methodType":"hmtMethod","methodName":"trim","signature":"astr.trim ()","description":"Removes any spaces from the start and end of the string (string is changed in situ)","examples":["a = \"acbcdefgh\"","a.trim()"]},{"methodType":"hmtMethod","methodName":"split","signature":"astr.split (string)","description":"Splits at a string at a given character into a list of strings","examples":["a = \"acb,defgh\"","b = a.split(\",\")"]},{"methodType":"hmtMethod","methodName":"reverse","signature":"astr.reverse ()","description":"Returns the reverse the string ","examples":["a = \"acbdefgh\"","a_reverse = a.reverse()"]}]},{"recordType":"rtDataObject","moduleName":"ListObject","description":"This is the list object","methods":[{"methodType":"hmtMethod","methodName":"len","signature":"alist.len ()","description":"Returns the length of a list ","examples":["a = [1,2,3]","println (a.len())"]},{"methodType":"hmtMethod","methodName":"append","signature":"alist.append (3.14)","description":"Append the element to the list","examples":["a = [1,2,3]","a.append (3.14)"]},{"methodType":"hmtMethod","methodName":"remove","signature":"alist.remove (3)","description":"Remove an element from a list with given index (returns nothing), indexing starts at zero","examples":["a = [1,2,3]","a.remove (1)"]},{"methodType":"hmtMethod","methodName":"insert","signature":"alist.insert (index, 5.4)","description":"Insert an element into a list at a given index (returns nothing)","examples":["a = [1,2,3]","a.insert (1, 3.5)"]},{"methodType":"hmtMethod","methodName":"sum","signature":"value = alist.sum ()","description":"Find the sum of values in a list. Only works if the list has numerial entries","examples":["a = [1,2,3]","println (a.sum())"]},{"methodType":"hmtMethod","methodName":"pop","signature":"value = alist.pop ()","description":"Remove the last element from a list and returns the value","examples":["a = [1,2,3]","element = a.pop()"]},{"methodType":"hmtMethod","methodName":"max","signature":"value = alist.max ()","description":"Find the maximum value is a 1D list of values.","examples":["a = [1,2,3]","element = a.max()"]},{"methodType":"hmtMethod","methodName":"min","signature":"value = alist.min ()","description":"Find the minimum value is a 1D list of values.","examples":["a = [1,2,3]","element = a.min()"]}]},{"recordType":"rtDataObject","moduleName":"ArrayObject","description":"To is an array object","methods":[{"methodType":"hmtMethod","methodName":"len","signature":"an_array.len ()","description":"Returns the length of an array ","examples":["a = array (30)","println (a.len())"]},{"methodType":"hmtMethod","methodName":"shape","signature":"shape = an_array.shape ()","description":"Get the dimensions of the array","examples":["a = array (30)","println (a.shape()"]},{"methodType":"hmtMethod","methodName":"ndim","signature":"shape = an_array.ndim ()","description":"Get the number of dimensions of the array.","examples":["a = array (30, 40)","println (a.ndim())"]},{"methodType":"hmtMethod","methodName":"rows","signature":"n = an_array.rows ()","description":"Get the number of rows of an array (only applies to 2D arrays)","examples":["a = array (30, 40)","println (a.rows())"]},{"methodType":"hmtMethod","methodName":"cols","signature":"n = an_array.rows ()","description":"Get the number of cols of an array (only applies to 2D arrays)","examples":["a = array (30, 40)","println (a.cols()"]},{"methodType":"hmtMethod","methodName":"toMatrix","signature":"n = an_array.toMatrix ()","description":"Convert a 2D array into a matrix","examples":["a = array (30, 40)","m = var.toMatrix()"]},{"methodType":"hmtMethod","methodName":"appendRow","signature":"new_array = an_array.appendRow (array)","description":"Append a row to a 2D array and return a new array","examples":["a = array (5, 3)","b = a.appendRow (array(2,3))"]},{"methodType":"hmtMethod","methodName":"appendCol","signature":"new_array = an_array.appendCol (array)","description":"Append a row to a 2D array and return a new array","examples":["a = array (5, 3)","b = a.appendCol (array(5,1))"]},{"methodType":"hmtMethod","methodName":"tr","signature":"an_array.tr()","description":"Returns the transpose a 2D array","examples":["a = array (5, 3)","new_a = a.tr()"]}]}]}